---
import { Image } from 'astro:assets';
import SiteShell from '../components/SiteShell.astro';
import PostMeta from '../components/ui/meta/PostMeta.astro';
import PostNav from '../components/ui/nav/PostNav.astro';
import { slugifyTag } from '../lib/slug';
import BlogTranslationScript from '../components/blog/BlogTranslationScript.astro';
import type { BlogLanguageMeta, BlogPostGroup } from '../lib/blog';

interface Props {
  postGroup: BlogPostGroup;
  languageMeta: BlogLanguageMeta[];
  showHeader?: boolean;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  readingTimeMin?: number;
}

const {
  postGroup,
  languageMeta,
  showHeader = true,
  prevPost = null,
  nextPost = null,
  readingTimeMin = 1,
} = Astro.props as Props;

const defaultPost = postGroup.defaultPost;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
} = defaultPost.data;
const tags = Array.isArray(defaultPost.data.tags) ? defaultPost.data.tags : [];
const authorName = defaultPost.data.author || 'Jay Yu';
const languages = languageMeta.map((item) => item.language).join(',');
---

<SiteShell title={title} description={description} image={heroImage} mainClass="article-main">
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    {pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
    <meta property="article:author" content={authorName} />
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
      datePublished: pubDate ? new Date(pubDate).toISOString() : undefined,
      dateModified: updatedDate ? new Date(updatedDate).toISOString() : undefined,
      author: [{ '@type': 'Person', name: authorName }],
      publisher: { '@type': 'Organization', name: 'jayyu.dev' },
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
      url: new URL(Astro.url.pathname, Astro.site).toString(),
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).toString() },
      ],
    })} />
  </Fragment>

  <article
    class="article-shell"
    data-blog-translation-root
    data-blog-article
    data-blog-slug={postGroup.slug}
    data-default-language={postGroup.defaultLanguage}
    data-current-language={postGroup.defaultLanguage}
    data-languages={languages}
  >
    {showHeader && (
      <header class:list={['article-hero', { 'article-hero--text-only': !heroImage }]}>
        {heroImage && (
          <div class="article-hero__media">
            <Image width={1280} height={720} src={heroImage} alt="" />
          </div>
        )}
        <div class="article-terminal">
          <h1 class="blog-translation-stack" data-blog-copy="title">
            {languageMeta.map((item) => (
              <span
                class:list={['blog-lang-fragment', { 'is-active': item.language === postGroup.defaultLanguage }]}
                data-blog-lang={item.language}
                aria-hidden={item.language === postGroup.defaultLanguage ? 'false' : 'true'}
              >
                {item.title}
              </span>
            ))}
          </h1>
          <p class="blog-translation-stack" data-blog-copy="description">
            {languageMeta.map((item) => (
              <span
                class:list={['blog-lang-fragment', { 'is-active': item.language === postGroup.defaultLanguage }]}
                data-blog-lang={item.language}
                aria-hidden={item.language === postGroup.defaultLanguage ? 'false' : 'true'}
              >
                {item.description}
              </span>
            ))}
          </p>
          {tags.length > 0 && (
            <div class="chip-row">
              {tags.map((tag) => (
                <a class="sw-tag" href={`/blog/tag/${slugifyTag(tag)}/`}>{tag}</a>
              ))}
            </div>
          )}
        </div>
      </header>
    )}

    <div class="article-grid">
      <div class="article-aside">
        <PostMeta
          pubDate={pubDate}
          readingTimeMin={readingTimeMin}
          authorName={authorName}
          title={title}
          url={Astro.url.toString()}
          showTranslation={languageMeta.length > 1}
        />
      </div>
      <div class="prose article-prose">
        <slot />
        <PostNav prev={prevPost} next={nextPost} />
      </div>
    </div>
  </article>
  <BlogTranslationScript />
</SiteShell>
