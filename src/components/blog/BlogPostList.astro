---
import PostCard from '../ui/card/PostCard.astro';
import BlogTranslationScript from './BlogTranslationScript.astro';
import type { BlogPostGroup } from '../../lib/blog';

interface Props {
  posts: BlogPostGroup[];
  title?: string;
  label?: string;
}

const { posts = [], title = 'All posts', label } = Astro.props as Props;
---

<section class="blog-list-module">
  <div class="module-header">
    <div>
      {label && <span class="module-label">{label}</span>}
      <h2>{title}</h2>
    </div>
  </div>
  <div class="blog-grid">
    {posts.map((post) => (
      <PostCard postGroup={post} />
    ))}
  </div>
  <BlogTranslationScript />
</section>
