---
import type { CollectionEntry } from 'astro:content';
import PostCard from '../ui/card/PostCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
  label?: string;
}

const { posts = [], title = 'All posts', label } = Astro.props as Props;
---

<section class="blog-list-module">
  <div class="module-header">
    <div>
      {label && <span class="module-label">{label}</span>}
      <h2>{title}</h2>
    </div>
  </div>
  <div class="blog-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</section>
