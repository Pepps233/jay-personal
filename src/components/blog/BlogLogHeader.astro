---
interface Props {
  title: string;
  description?: string;
  label?: string;
  count?: number;
}

const { title, description, label, count } = Astro.props as Props;
---

<section class="blog-log-header">
  {label && <div class="module-label">{label}</div>}
  <div class="blog-log-header__inner">
    <div>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <div class="blog-log-header__actions">
      {typeof count === 'number' && <span class="status-chip">{count} posts</span>}
    </div>
  </div>
</section>
