---
interface Cta {
  text: string;
  href: string;
}

interface Props {
  title: string;
  tagline: string;
  primaryCTA?: Cta;
  secondaryCTA?: Cta;
}

const { title, tagline, primaryCTA, secondaryCTA } = Astro.props as Props;
---

<section class="pixel-hero" aria-labelledby="home-title">
  <div class="pixel-hero__visual" aria-hidden="true">
    <div class="pixel-mosaic">
      {Array.from({ length: 64 }).map((_, index) => (
        <span style={`--i: ${index}`} />
      ))}
    </div>
    <div class="pixel-hero__readout">
      <span>BUILD_ID</span>
      <strong>jayyu.dev</strong>
    </div>
  </div>
  <div class="pixel-hero__content">
    <span class="status-chip status-chip--live">STATUS / BUILDING</span>
    <h1 id="home-title">{title}</h1>
    <p>{tagline}</p>
    {(primaryCTA || secondaryCTA) && (
      <div class="hero-actions">
        {primaryCTA && <a class="dev-button dev-button--primary" href={primaryCTA.href}>{primaryCTA.text}</a>}
        {secondaryCTA && <a class="dev-button" href={secondaryCTA.href}>{secondaryCTA.text}</a>}
      </div>
    )}
  </div>
</section>
