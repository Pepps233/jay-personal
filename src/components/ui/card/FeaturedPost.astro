---
import { Image } from 'astro:assets';
import FormattedDate from '../../FormattedDate.astro';
import { slugifyTag as slugify } from '../../../lib/slug';
import { getBlogLanguageMeta, getPostHref, type BlogPostGroup } from '../../../lib/blog';

interface Props {
  postGroup: BlogPostGroup;
  readingTimeMin?: number;
}

const { postGroup, readingTimeMin = 0 } = Astro.props as Props;
const post = postGroup.defaultPost;
const languageMeta = getBlogLanguageMeta(postGroup);
const languages = languageMeta.map((item) => item.language).join(',');
const tags = post.data.tags || [];
const href = getPostHref(postGroup);
const titleAttributes = Object.fromEntries(
  languageMeta.map((item) => [`data-title-${item.language}`, item.title])
);
---

<article
  class="module-card featured-post"
  data-blog-translation-root
  data-blog-card
  data-blog-slug={postGroup.slug}
  data-default-language={postGroup.defaultLanguage}
  data-current-language={postGroup.defaultLanguage}
  data-languages={languages}
>
  {post.data.heroImage && (
    <div class="featured-post__image">
      <Image width={1200} height={675} src={post.data.heroImage} alt={post.data.title} />
    </div>
  )}
  <div class="featured-post__body">
    <div class="post-card__meta">
      <span>Featured</span>
      <span><FormattedDate date={post.data.pubDate} /></span>
      {readingTimeMin > 0 && <span>{readingTimeMin} min read</span>}
    </div>
    <h3 class="blog-translation-stack" data-blog-copy="title">
      {languageMeta.map((item) => (
        <span
          class:list={['blog-lang-fragment', { 'is-active': item.language === postGroup.defaultLanguage }]}
          data-blog-lang={item.language}
          aria-hidden={item.language === postGroup.defaultLanguage ? 'false' : 'true'}
        >
          {item.title}
        </span>
      ))}
    </h3>
    <p class="blog-translation-stack" data-blog-copy="description">
      {languageMeta.map((item) => (
        <span
          class:list={['blog-lang-fragment', { 'is-active': item.language === postGroup.defaultLanguage }]}
          data-blog-lang={item.language}
          aria-hidden={item.language === postGroup.defaultLanguage ? 'false' : 'true'}
        >
          {item.description}
        </span>
      ))}
    </p>
    <div class="post-card__meta mt-4">
      <a href={`/blog/author/${slugify(post.data.author || 'Jay Yu')}/`} class="interactive-link">{post.data.author || 'Jay Yu'}</a>
      {post.data.category && <span>{post.data.category}</span>}
    </div>
    {tags.length > 0 && (
      <div class="post-card__tags">
        {tags.map((tag) => (
          <a href={`/blog/tag/${slugify(tag)}/`} class="sw-tag interactive-link">{tag}</a>
        ))}
      </div>
    )}
    <div class="card-actions card-actions--inline">
      <a class="dev-button dev-button--primary interactive-link" href={href}>Read post</a>
      <button type="button" class="dev-button blog-translate-btn interactive-link" data-blog-translate-toggle>
        <span data-blog-translate-label>Translate</span>
      </button>
    </div>
  </div>
  <a href={href} class="stretched-link" data-blog-read-link aria-label={`Read ${post.data.title}`} {...titleAttributes}></a>
</article>
