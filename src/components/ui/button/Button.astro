---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center rounded-[4px] font-semibold starwind-transition-colors no-underline font-[var(--font-display)] border';
const sizes: Record<string, string> = {
  sm: 'px-3 py-2 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-5 py-3 text-lg',
};
const variants: Record<string, string> = {
  primary: 'text-white !text-white hover:!text-white focus:!text-white active:!text-white bg-[var(--accent-dark)] border-[var(--accent-dark)] hover:bg-[color:var(--color-text-primary)] hover:border-[color:var(--color-text-primary)]',
  secondary: 'text-[var(--accent-dark)] border-[var(--accent)] bg-white hover:bg-[color:var(--tag-pill-bg)]',
  ghost: 'text-[color:var(--color-text-secondary)] border-transparent bg-transparent hover:bg-[color:var(--color-bg-secondary)]',
  outline: 'text-foreground border-[var(--color-border)] bg-white hover:border-[var(--accent)] hover:text-[var(--accent-dark)]',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  {...rest}
>
  <slot />
</Tag>
