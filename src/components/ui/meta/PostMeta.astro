---
import { author } from '../../../data/author';
import FormattedDate from '../../FormattedDate.astro';
import { slugifyTag as slugify } from '../../../lib/slug';
import ShareButtons from '../share/ShareButtons.astro';

interface Props {
  pubDate: Date;
  readingTimeMin: number;
  authorName?: string;
  title: string;
  url: string;
}

const { pubDate, readingTimeMin, authorName, title, url } = Astro.props as Props;
const displayName = authorName || author.name;
---

<aside class="module-card article-meta-card" aria-label="Post metadata">
  <div class="article-meta-card__author">
    <img src={author.avatar.src} alt={author.name} width="42" height="42" />
    <div>
      <span class="module-label">Author</span>
      <a href={`/blog/author/${slugify(displayName)}/`} class="article-meta-card__name no-underline">{displayName}</a>
    </div>
  </div>
  <dl>
    <dt>Date</dt>
    <dd><FormattedDate date={pubDate} /></dd>
    <dt>Read</dt>
    <dd>{readingTimeMin} min</dd>
  </dl>
  <ShareButtons title={title} url={url} />
</aside>
