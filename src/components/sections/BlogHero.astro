---
import BlogLogHeader from '../blog/BlogLogHeader.astro';

interface Props {
  title?: string;
  subtitle?: string;
  count?: number;
  feedHref?: string;
}

const { title = 'Blog', subtitle, count, feedHref } = Astro.props as Props;
---

<BlogLogHeader title={title} description={subtitle} count={count} feedHref={feedHref} />
