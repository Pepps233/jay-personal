---
interface StudyItem {
  title: string;
  institution: string;
  description: string;
  tags?: string[];
  date?: string;
}

interface Props {
  items: StudyItem[];
  title?: string;
}

const { items, title = "Studies" } = Astro.props as Props;
---

<section class="dev-section" aria-labelledby="studies-title">
  <div class="module-header">
    <div>
      <span class="module-label">EDU</span>
      <h2 id="studies-title">{title}</h2>
    </div>
    <span class="status-chip">{items.length} RECORDS</span>
  </div>

  <div class="dashboard-grid">
    {items.map((study) => (
      <article class="module-card study-card">
        <div class="project-card__topline">
          <span>{study.date || "ACTIVE"}</span>
          <strong>STUDY</strong>
        </div>
        <h3>{study.title}</h3>
        <p class="work-card__company">{study.institution}</p>
        <p>{study.description}</p>
        {study.tags && study.tags.length > 0 && (
          <div class="chip-row">
            {study.tags.map((tag) => (
              <span class="tech-chip">{tag}</span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
