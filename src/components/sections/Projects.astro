---
import { projects } from "../../data/projects";

const monthRank = new Map(
  [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ].map((month, index) => [month, index])
);

function projectDateRank(date?: string) {
  if (!date) return Number.MAX_SAFE_INTEGER;

  const [year, month, day] = date.split(/\s+/);
  const parsedYear = Number(year);
  const parsedMonth = monthRank.get(month) ?? 0;
  const parsedDay = Number(day) || 1;

  return parsedYear * 372 + parsedMonth * 31 + parsedDay;
}

const projectItems = projects.slice().sort((a, b) => projectDateRank(b.date) - projectDateRank(a.date)).map((project) => ({
  ...project,
  technologies: project.techStack.split("•").map((item) => item.trim()).filter(Boolean),
}));
---

<section class="dev-section" aria-label="Project cards">
  <div class="dashboard-grid">
    {projectItems.map((project) => (
      <article class="module-card project-card">
        <div class="project-card__topline">
          <span>{project.date || "Recent"}</span>
        </div>
        <div class="project-card__icon" aria-hidden="true" set:html={project.icon} />
        <h3>{project.title}</h3>
        <div class="chip-row" aria-label={`${project.title} stack`}>
          {project.technologies.map((tech) => (
            <span class="tech-chip">{tech}</span>
          ))}
        </div>
        {Array.isArray(project.description) ? (
          <ul>
            {project.description.map((desc) => (
              <li>{desc}</li>
            ))}
          </ul>
        ) : (
          <p>{project.description}</p>
        )}
        <div class="card-actions">
          <a class="dev-button" href={project.ctaLink} target="_blank" rel="noopener noreferrer">{project.ctaText}</a>
        </div>
      </article>
    ))}
  </div>
</section>
