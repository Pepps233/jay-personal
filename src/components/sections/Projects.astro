---
import { projects } from "../../data/projects";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Projects", description = "Selected builds with clear inputs, constraints, and outputs." } = Astro.props as Props;

const projectItems = projects.map((project) => ({
  ...project,
  technologies: project.techStack.split("•").map((item) => item.trim()).filter(Boolean),
}));
---

<section class="dev-section" aria-labelledby="projects-title">
  <div class="module-header">
    <div>
      <span class="module-label">Projects</span>
      <h2 id="projects-title">{title}</h2>
    </div>
    <span class="status-chip">{projectItems.length} builds</span>
  </div>
  <p class="section-copy">{description}</p>

  <div class="dashboard-grid">
    {projectItems.map((project) => (
      <article class="module-card project-card">
        <div class="project-card__topline">
          <span>{project.date || "Recent"}</span>
          <strong>Project</strong>
        </div>
        <div class="project-card__icon" aria-hidden="true" set:html={project.icon} />
        <h3>{project.title}</h3>
        <div class="chip-row" aria-label={`${project.title} stack`}>
          {project.technologies.map((tech) => (
            <span class="tech-chip">{tech}</span>
          ))}
        </div>
        {Array.isArray(project.description) ? (
          <ul>
            {project.description.map((desc) => (
              <li>{desc}</li>
            ))}
          </ul>
        ) : (
          <p>{project.description}</p>
        )}
        <div class="card-actions">
          <a class="dev-button" href={project.ctaLink} target="_blank" rel="noopener noreferrer">{project.ctaText}</a>
        </div>
      </article>
    ))}
  </div>
</section>
