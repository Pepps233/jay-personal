---
interface ExperienceItem {
  title: string;
  company: string;
  region: string;
  description: string[];
  technologies?: string[];
  date?: string;
}

interface Props {
  items: ExperienceItem[];
  title?: string;
}

const { items, title = "Experience" } = Astro.props as Props;
---

<section class="dev-section" aria-labelledby="work-title">
  <div class="module-header">
    <div>
      <span class="module-label">Work</span>
      <h2 id="work-title">{title}</h2>
    </div>
    <span class="status-chip">{items.length} items</span>
  </div>

  <div class="work-log">
    {items.map((item) => (
      <article class="module-card work-card">
        <div class="work-card__rail" aria-hidden="true"></div>
        <div>
          <div class="project-card__topline">
            <span>{item.date || "Now"}</span>
            <strong>{item.region || "Remote"}</strong>
          </div>
          <h3>{item.title}</h3>
          <p class="work-card__company">{item.company}</p>
          <ul>
            {item.description.map((desc) => (
              <li>{desc}</li>
            ))}
          </ul>
          {item.technologies && item.technologies.length > 0 && (
            <div class="chip-row">
              {item.technologies.map((tech) => (
                <span class="tech-chip">{tech}</span>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
