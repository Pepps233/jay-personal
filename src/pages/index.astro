---
import SiteShell from '../components/SiteShell.astro';
import PixelHero from '../components/PixelHero.astro';
import StatusPanel from '../components/StatusPanel.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import WorkExperience from '../components/sections/WorkExperience.astro';
import Studies from '../components/sections/Studies.astro';
import Projects from '../components/sections/Projects.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { skills } from '../data/skills';
import { work } from '../data/work';
import { studies } from '../data/studies';
import { statusItems } from '../data/status';
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Jay Yu',
      alternateName: 'Jiale Yu',
      url: new URL('/', Astro.site).toString(),
      sameAs: [
        'https://github.com/Pepps233',
        'https://www.linkedin.com/in/yujay1/',
      ],
    })} />
  </Fragment>

  <PixelHero
    title="Jay (Jiale) Yu"
    tagline="Computer science student, founder, and builder working across backend systems, machine learning, and robotics software."
    primaryCTA={{ text: 'Projects', href: '/portfolio' }}
    secondaryCTA={{ text: 'Read log', href: '/blog' }}
  />

  <StatusPanel items={statusItems} />

  <div class="pixel-divider" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <Projects title="Selected projects" description="Compact build notes from robotics, computer vision, backend services, and tooling." />
  <SkillsSection title="Working stack" skills={skills} />
  <WorkExperience title="Work log" items={work} />
  <Studies title="Studies" items={studies} />
</SiteShell>
