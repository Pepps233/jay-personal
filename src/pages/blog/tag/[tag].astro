---
import { getCollection } from 'astro:content';
import SiteShell from '../../../components/SiteShell.astro';
import BlogLogHeader from '../../../components/blog/BlogLogHeader.astro';
import BlogPostList from '../../../components/blog/BlogPostList.astro';
import { slugifyTag } from '../../../lib/slug';
import { getTagMeta } from '../../../data/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
  return tags.map((tag) => ({ params: { tag: slugifyTag(tag) } }));
}

const { tag } = Astro.params;
const posts = (await getCollection('blog'))
  .filter((post) => (post.data.tags || []).some((item) => slugifyTag(item) === tag))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const meta = getTagMeta(tag);
---

<SiteShell title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`Tag: ${tag} feed`} href={`/rss/tag/${tag}.xml`} />
  </Fragment>

  <BlogLogHeader
    title={meta.title}
    description={meta.description}
    label="TAG"
    count={posts.length}
    feedHref={`/rss/tag/${tag}.xml`}
  />
  <BlogPostList posts={posts} title="Tagged logs" />
</SiteShell>
